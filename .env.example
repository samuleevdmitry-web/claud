# База данных. Для Docker Compose — PostgreSQL, для локальной разработки можно SQLite.
DATABASE_URL=postgresql+psycopg://tenders:tenders@db:5432/tenders
# DATABASE_URL=sqlite:///./data/app.db

# Администратор приложения. Пустой пароль — вход без пароля (только для разработки).
# Менеджеров (доступ только к тендерам и уведомлениям) добавляет администратор на странице «Пользователи».
APP_USERNAME=velmorium
APP_PASSWORD=change-me
# Ключ подписи входа. Пусто — создаётся автоматически в data/secret_key.
SECRET_KEY=
# Доступ с других компьютеров локальной сети: 0.0.0.0 (по умолчанию 127.0.0.1 — только этот компьютер).
APP_BIND=127.0.0.1
# Адрес, по которому менеджеры открывают приложение (для ссылок в письмах), например http://192.168.1.10:8000
APP_BASE_URL=
# Сайт менеджеров на обычном хостинге (папка portal/, docs/portal.md): адрес поддомена и ключ обмена —
# такой же, как sync_token в portal/config.php на хостинге. Обмен — после прогона и каждые N минут.
PORTAL_URL=
PORTAL_TOKEN=
PORTAL_SYNC_MINUTES=10
# Размещение на сервере с HTTPS (docs/deploy.md): домен приложения и доверие заголовкам прокси Caddy.
DOMAIN=
FORWARDED_ALLOW_IPS=127.0.0.1

# Файл ключевых слов, который импортируется при первом запуске.
KEYWORDS_FILE=./Velmorium_ключевые_слова_тендеры.xlsx
# Правило беглой гласной при сопоставлении масок (подушк* ловит «подушек»).
MASK_FLEETING_VOWELS=true

# Расписание прогонов (значения по умолчанию; меняются на странице «Площадки»).
SCHEDULER_ENABLED=true
RUN_INTERVAL_HOURS=48
RUN_START_TIME=06:00
TIMEZONE=Europe/Moscow
INITIAL_HISTORY_DAYS=30
SEARCH_OVERLAP_DAYS=2

# Вежливые лимиты для площадок.
REQUEST_DELAY_MIN=2
REQUEST_DELAY_MAX=5
# Укажите контакт, чтобы площадка могла связаться с владельцем робота.
USER_AGENT=VelmoriumTenderMonitor/0.1

# ЕИС через ГосПлан API. Пусто — тестовый сервер (10 запросов в минуту).
GOSPLAN_API_KEY=
# Токен для POST /api/import (приём данных от Claude in Chrome и других сборщиков).
IMPORT_TOKEN=

# Пароль базы для docker-compose.
POSTGRES_PASSWORD=tenders

# Уведомления (необязательно).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Группа менеджеров в Telegram: только сообщения о новых тендерах.
TELEGRAM_MANAGERS_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# OAuth-токен Яндекса с правами metrika:read, webmaster:hostinfo, webmaster:verify (как получить — README.md).
YANDEX_OAUTH_TOKEN=

# Счётчики сайтов через запятую; первый — основной в дашборде. 28874860 — oldos.ru, 109722704 — oldos.kz.
METRIKA_COUNTERS=28874860,109722704

# ID целей, которые считаются заявкой, через запятую (ID уникальны во всей Метрике). Список целей: python -m analytics check
# oldos.ru: «отправил контактные данные», «Ecommerce: покупка»; oldos.kz: «отправил контактные данные».
METRIKA_LEAD_GOALS=339016174,556187471,582128135

# Счётчики карточек на Картах (создаёт Яндекс Бизнес). 59047588 — сеть «Олдос», 103944019 — Oldos Group, Алматы.
METRIKA_MAPS_COUNTERS=59047588,103944019

# Модель атрибуции источников: lastsign (последний значимый переход), last, first.
METRIKA_ATTRIBUTION=lastsign

# Сайты в Вебмастере в формате API, через запятую (список: python -m analytics check).
WEBMASTER_HOSTS=https:www.oldos.ru:443,https:oldos.kz:443

# База. В docker compose задаётся автоматически; эта строка — для запуска команд с ноутбука вне Docker.
DATABASE_URL=postgresql://analytics:analytics@localhost:5433/analytics

# Вордстат (Yandex Cloud): ID каталога и API-ключ сервисного аккаунта с ролью search-api.webSearch.user.
WORDSTAT_FOLDER_ID=b1g04gaush4hgtd8l7me
WORDSTAT_API_KEY=

# OAuth-токен Яндекса с правами metrika:read, webmaster:hostinfo, webmaster:verify.
# Как получить — см. README.md.
YANDEX_OAUTH_TOKEN=

# Номер счётчика Метрики: oldos.ru = 28874860 (виден в адресе отчёта: metrika.yandex.ru/dashboard?id=XXXXXXXX).
METRIKA_COUNTER_ID=28874860

# ID целей Метрики, которые считаются заявкой, через запятую. Список целей: python -m analytics check
METRIKA_LEAD_GOALS=

# Счётчики карточек на Картах (создаёт Яндекс Бизнес), через запятую. 59047588 — сеть «Олдос».
METRIKA_MAPS_COUNTERS=59047588

# Модель атрибуции источников: lastsign (последний значимый переход), last, first.
METRIKA_ATTRIBUTION=lastsign

# Сайт в Вебмастере в формате API (список: python -m analytics check).
WEBMASTER_HOST_ID=https:www.oldos.ru:443

DATABASE_URL=postgresql://analytics:analytics@localhost:5432/analytics
